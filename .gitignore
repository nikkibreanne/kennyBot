# directories
/node_modules

# private working docs / local notes (project standard — never committed)
.workspace/

# secrets — NEVER commit
*.env
.env*
!.env.example
*.scas
serviceAccount*.json
serviceAccount*.json.*

# persisted Twitch refresh-token store (the writable runtime volume; §F)
/.tokens/
/.tokens-dev/
/data/

# local Firebase emulator artifacts
/.firebase/
firebase-debug.log
database-debug.log
ui-debug.log
firestore-debug.log

# legacy local fixture (state now lives in Firebase)
db.json
db.json.*

# Chase monitor logs. They record the PRIVATE roster's org ids verbatim, so a copy
# landing anywhere git can see it puts real outlet names in a public repo — and
# `git add -A` would stage them. `.workspace/` is the intended destination; this
# covers the top-level path the runbook used to suggest.
chase-logs/
